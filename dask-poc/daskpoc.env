# Copy this file to daskpoc.env and fill in your values:
#   cp daskpoc.env.example daskpoc.env
#
# daskpoc.env is sourced automatically by submit_scheduler.sh,
# submit_workers.sh, and submit_aoflagger_idg_on_msv4_lofar.sh, before they
# check any required variable is set. It captures the full configuration
# of a run in one place — worth keeping a copy alongside a run's
# results/logs so you can tell later exactly what config produced them.
#
# daskpoc.env is gitignored (see .gitignore in this directory) since it
# holds personal paths — only daskpoc.env.example is meant to be committed.
#
# Every assignment below uses ${VAR:-default} rather than a plain export,
# so a variable already exported in the calling shell before daskpoc.env
# is sourced is left untouched — daskpoc.env only fills in what isn't
# already set. This lets a script (e.g. a test/smoke-test wrapper) export
# its own known values ahead of calling submit_*.sh and have them win over
# whatever is sitting in daskpoc.env.

# --- Environment flavor --------------------------------------------------
# 1 = Zarr 3, 0 (or unset) = default Zarr 2.
# Equivalent to always passing --zarr3 on the command line to any of the
# submit_*.sh scripts; an explicit --zarr3 on the command line still works
# too (it's a no-op on top of this, not a way to force Zarr 2 back off).
export DASKPOC_ZARR3="${DASKPOC_ZARR3:-0}"

# --- Shared by the scheduler, workers, and the client --------------------
export DASKPOC_INSTALL_DIR="${DASKPOC_INSTALL_DIR:-/work/scitas-ge/$USER/KUMA_VENVS/DASK-CUDA_26.04}"
export DASKPOC_SCHEDULER_DIR="${DASKPOC_SCHEDULER_DIR:-/scratch/$USER/dask-cuda_26.04_scheduler_directory}"

# --- SLURM job logs (scheduler/workers only) ------------------------------
# Optional — submit_scheduler.sh/submit_workers.sh default this to "." if
# unset.
export DASKPOC_DASK_LOGS_DIR="${DASKPOC_DASK_LOGS_DIR:-/scratch/$USER/dask-cuda-logs}"

# --- Workers ---------------------------------------------------------------
# Default worker topology for submit_workers.sh; still overridable with
# --ntasks/--ntasks-per-node on the command line.
export DASKPOC_NTASKS="${DASKPOC_NTASKS:-4}"
export DASKPOC_NTASKS_PER_NODE="${DASKPOC_NTASKS_PER_NODE:-4}"

# --- Client (AOFlagger/IDG on MSv4/LOFAR) -----------------------------------
export DASKPOC_OUTPUT_DIR="${DASKPOC_OUTPUT_DIR:-/work/scitas-ge/$USER/daskpoc}"
export DASKPOC_DATA_REPO="${DASKPOC_DATA_REPO:-/work/scitas-ge/$USER/MSV2_MSV4}"
export DASKPOC_DATA_PROC="${DASKPOC_DATA_PROC:-/scratch/$USER/aoflagger_on_msv4}"
